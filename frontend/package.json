{
  "name": "psx-web-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/psx-wasm --target web --out-dir ../../frontend/src/wasm --out-name psx",
    "wasm:release": "wasm-pack build ../crates/psx-wasm --release --target web --out-dir ../../frontend/src/wasm --out-name psx",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm:release && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wasm-pack": "^0.13.1"
  }
}
